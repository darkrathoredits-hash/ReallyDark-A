local acc = 0
track(RunService.Heartbeat:Connect(function(dt)
	updateLighting()
	acc += dt
	if acc >= 0.1 then
		acc = 0
		updateHitboxes()
		updateESP()
	end
end))

----------------------------------------------------------------------
-- cleanup
----------------------------------------------------------------------

local function cleanup()
	alive = false
	currentTarget = nil
	for _, conn in ipairs(connections) do
		pcall(function() conn:Disconnect() end)
	end
	table.clear(connections)
	restoreHitboxes()
	restoreLighting()
	if S.CustomFOV then
		pcall(function() Camera.FieldOfView = origCamFov end)
	end
	for p in pairs(espObjs) do
		removeESP(p)
	end
	if fovCircle then
		pcall(function() fovCircle:Remove() end)
	end
	if gui then gui:Destroy() end
end

if getgenv then
	getgenv().SOAS_Cleanup = cleanup
end

