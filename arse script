--// state
local conns = {}
local function bind(sig, fn)
	local c = sig:Connect(fn)
	conns[#conns + 1] = c
	return c
end

local function mk(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	if parent then o.Parent = parent end
	return o
end
local function corner(p, r) return mk("UICorner", { CornerRadius = UDim.new(0, r) }, p) end
local function stroke(p, color, thick, transp)
	return mk("UIStroke", {
		Color = color, Thickness = thick, Transparency = transp,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, p)
end
local function tw(inst, t, props, style, dir)
	local tween = TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

--// players / helpers
local function getChar(p)
	local c = p.Character
	if not c then return end
	local hum = c:FindFirstChildOfClass("Humanoid")
	local root = c:FindFirstChild("HumanoidRootPart")
	local head = c:FindFirstChild("Head")
	if hum and root and head and hum.Health > 0 then
		return c, hum, root, head
	end
end

local function isEnemy(p)
	if p == lp then return false end
	if not cfg.teamCheck then return true end
	if lp.Team ~= nil and p.Team == lp.Team then return false end
	return true
end

