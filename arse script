--// drag
local dragging, dragStart, startPos = false, nil, nil
topBar.InputBegan:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
		dragging, dragStart, startPos = true, i.Position, window.Position
	end
end)
bind(UIS.InputChanged, function(i)
	if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
		local d = i.Position - dragStart
		window.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
	end
end)
bind(UIS.InputEnded, function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)

--// main loop
local gunTick = 0
bind(RunService.RenderStepped, function(dt)
	local t = os.clock()
	local cam = Workspace.CurrentCamera

	edgeGrad.Rotation = (t * 45) % 360
	shineGrad.Rotation = 35 + math.sin(t * 0.6) * 25
	titleGrad.Offset = Vector2.new(math.sin(t * 1.2) * 0.4, 0)
	for _, o in ipairs(orbs) do
		o.f.Position = UDim2.fromScale(
			o.ax + math.sin(t * o.sp + o.ph) * 0.09,
			o.ay + math.cos(t * o.sp * 0.8 + o.ph) * 0.09
		)
	end

	local m = UIS:GetMouseLocation()
	fovRing.Visible = cfg.aim and cfg.showFov
	fovRing.Size = UDim2.fromOffset(cfg.aimFov * 2, cfg.aimFov * 2)
	fovRing.Position = UDim2.fromOffset(m.X, m.Y)
	crosshair.Visible = cfg.crosshair
	silentRing.Visible = cfg.silent and cfg.showFov and hooksOk
	silentRing.Size = UDim2.fromOffset(cfg.silentFov * 2, cfg.silentFov * 2)
	silentRing.Position = UDim2.fromOffset(m.X, m.Y)

	if cam then
		stepEsp(cam)
		if cfg.fovOn then cam.FieldOfView = cfg.fov end
	end
	stepTrigger()
	stepSilent(cam)

	if cfg.fullbright then
		Lighting.Brightness = 2
		Lighting.ClockTime = 14
		Lighting.FogEnd = 1e6
		Lighting.Ambient = Color3.fromRGB(190, 190, 190)
		Lighting.OutdoorAmbient = Color3.fromRGB(190, 190, 190)
	end

	if cfg.gunMods then
		gunTick = gunTick + dt
		if gunTick > 4 then
			gunTick = 0
			applyGunMods(true)
		end
	end
end)

