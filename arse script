local function addCycle(page, text, key, options)
	local row = mkRow(page, 38)
	local lbl = mkText(row, "", 13, UDim2.new(1, -24, 1, 0), UDim2.new(0, 12, 0, 0))
	local function render() lbl.Text = text .. ":  " .. string.lower(tostring(cfg[key])) end
	render()
	local btn = mk("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 8 }, row)
	btn.Activated:Connect(function()
		local idx = table.find(options, cfg[key]) or 1
		cfg[key] = options[(idx % #options) + 1]
		render()
	end)
end

