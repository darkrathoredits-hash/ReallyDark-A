		Position = UDim2.new(0, 3, 0.5, -8), Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 7,
	}, sw)
	corner(knob, 8)
	local btn = mk("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 8 }, row)
	local function render(on)
		tw(sw, 0.22, { BackgroundColor3 = on and PINK or OFF })
		tw(knob, 0.22, { Position = on and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8) })
