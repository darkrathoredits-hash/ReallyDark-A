--// open / close
local function setMenu(open)
	menuOpen = open
	if open then
		window.Visible = true
		tw(window, 0.35, { GroupTransparency = 0 })
		tw(winScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
		tw(blur, 0.4, { Size = cfg.blur and 14 or 0 })
	else
		tw(window, 0.3, { GroupTransparency = 1 })
		tw(winScale, 0.3, { Scale = 0.9 })
		tw(blur, 0.3, { Size = 0 })
		task.delay(0.32, function()
			if not menuOpen and window then window.Visible = false end
		end)
	end
end

hideBtn.Activated:Connect(function() setMenu(false) end)
bind(UIS.InputBegan, function(i, gp)
	if gp then return end
	if i.KeyCode == Enum.KeyCode.RightShift then setMenu(not menuOpen) end
end)

