local pages, tabButtons = {}, {}
local function selectTab(name)
	for n, pg in pairs(pages) do pg.Visible = (n == name) end
	for n, b in pairs(tabButtons) do
		local on = n == name
		tw(b, 0.25, { BackgroundTransparency = on and 0.35 or 1, BackgroundColor3 = on and PINK or WHITE })
		b.TextColor3 = on and WHITE or SOFT
	end
end

local function addTab(name, order)
	local b = mk("TextButton", {
		Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = WHITE, BackgroundTransparency = 1,
		Text = name, Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = SOFT,
		AutoButtonColor = false, LayoutOrder = order, ZIndex = 5,
	}, sidebar)
	corner(b, 11)
	local pg = mk("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 3, ScrollBarImageColor3 = PINK, CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false, ZIndex = 5,
	}, content)
	mk("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, pg)
	mk("UIPadding", { PaddingRight = UDim.new(0, 6), PaddingBottom = UDim.new(0, 8) }, pg)
	pages[name], tabButtons[name] = pg, b
	b.Activated:Connect(function() selectTab(name) end)
	return pg
end

