		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = ACCENT,
		BorderSizePixel = 0,
		ZIndex = 6,
	}, bar)
	new("UICorner", { CornerRadius = UDim.new(0, 3) }, fill)

	local function refresh()
		text.Text = string.format("%s: %d", label, S[key])
		fill.Size = UDim2.new((S[key] - min) / (max - min), 0, 1, 0)
	end
	refresh()

