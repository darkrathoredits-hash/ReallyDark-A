--// aimbot
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function visibleTo(cam, part, char)
	rayParams.FilterDescendantsInstances = { lp.Character, cam }
	local origin = cam.CFrame.Position
	local res = Workspace:Raycast(origin, part.Position - origin, rayParams)
	return res == nil or res.Instance:IsDescendantOf(char)
end

local function closestTarget(cam, fov, wall, partName)
	local best, bestD
	local m = UIS:GetMouseLocation()
	for _, p in ipairs(Players:GetPlayers()) do
		if isEnemy(p) then
			local char, _, root, head = getChar(p)
			if char then
				local part = head
				if (partName or cfg.aimPart) == "Torso" then
					part = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or root
				end
				local pos, on = cam:WorldToViewportPoint(part.Position)
				if on then
					local d = (Vector2.new(pos.X, pos.Y) - m).Magnitude
					if d <= fov and (not bestD or d < bestD) then
						if not wall or visibleTo(cam, part, char) then
							best, bestD = part, d
						end
					end
				end
			end
		end
	end
	return best
end

local function stepAim()
	if not cfg.aim then return end
	if cfg.aimHold and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end
	local cam = Workspace.CurrentCamera
	if not cam then return end
	local part = closestTarget(cam, cfg.aimFov, cfg.wallCheck)
	if not part then return end
	local pos = part.Position + part.AssemblyLinearVelocity * (cfg.prediction * 0.01)
	local goal = CFrame.new(cam.CFrame.Position, pos)
	cam.CFrame = cam.CFrame:Lerp(goal, math.clamp(1 / cfg.aimSmooth, 0.03, 1))
end
RunService:BindToRenderStep("PinkAim", Enum.RenderPriority.Camera.Value + 1, stepAim)

--// triggerbot
local lastShot = 0
local function stepTrigger()
	if not cfg.trigger or not mouse1click then return end
	local t = mouse.Target
	if not t then return end
	local model = t:FindFirstAncestorOfClass("Model")
	local pl = model and Players:GetPlayerFromCharacter(model)
	if pl and isEnemy(pl) and getChar(pl) and (os.clock() - lastShot) * 1000 >= cfg.triggerDelay then
		lastShot = os.clock()
		pcall(mouse1click)
	end
end

--// silent aim (hooks, needs hookmetamethod + getnamecallmethod)
local unloaded = false
local silentPart = nil
local realWS = game.Workspace
local hooksOk = false
local oldNamecall, oldIndex

local function silentActive()
	return silentPart ~= nil and silentPart.Parent ~= nil and math.random(1, 100) <= cfg.hitChance
end
local function retarget(origin, dir)
	return (silentPart.Position - origin).Unit * dir.Magnitude
end

if hookmetamethod and getnamecallmethod then
	local wrap = newcclosure or function(f) return f end
	local isCaller = checkcaller or function() return false end

	local ok1 = pcall(function()
		oldNamecall = hookmetamethod(game, "__namecall", wrap(function(self, ...)
			local method = getnamecallmethod()
			if not unloaded and cfg.silent and silentPart and not isCaller() then
				local n = select("#", ...)
				if method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist" or method == "FindPartOnRay" then
					local args = { ... }
					if self == realWS and typeof(args[1]) == "Ray" and silentActive() then
						args[1] = Ray.new(args[1].Origin, retarget(args[1].Origin, args[1].Direction))
						if setnamecallmethod then setnamecallmethod(method) end
						return oldNamecall(self, unpack(args, 1, n))
					end
				elseif method == "Raycast" then
					local args = { ... }
					if self == realWS and typeof(args[1]) == "Vector3" and typeof(args[2]) == "Vector3" and silentActive() then
						args[2] = retarget(args[1], args[2])
						if setnamecallmethod then setnamecallmethod(method) end
						return oldNamecall(self, unpack(args, 1, n))
					end
				elseif method == "ScreenPointToRay" or method == "ViewportPointToRay" then
					if self == realWS.CurrentCamera and silentActive() then
						local ray = oldNamecall(self, ...)
						return Ray.new(ray.Origin, retarget(ray.Origin, ray.Direction))
					end
				end
			end
			return oldNamecall(self, ...)
		end))
	end)

	local ok2 = pcall(function()
		oldIndex = hookmetamethod(game, "__index", wrap(function(self, key)
			if not unloaded and cfg.silent and silentPart and self == mouse and not isCaller() then
				if key == "Hit" and silentActive() then return CFrame.new(silentPart.Position) end
				if key == "Target" and silentActive() then return silentPart end
			end
			return oldIndex(self, key)
		end))
	end)

	hooksOk = ok1 or ok2
end

--// silent aim target selection
local function stepSilent(cam)
	if not cfg.silent or not hooksOk or not cam then
		silentPart = nil
		return
	end
	silentPart = closestTarget(cam, cfg.silentFov, cfg.silentWall, cfg.silentPartName)
end

--// hitbox expander
local hbBackup = {}

local function hbRestore(part)
	local b = hbBackup[part]
	if not b then return end
	pcall(function()
		part.Size = b.Size
		part.Transparency = b.Transparency
		part.CanCollide = b.CanCollide
		part.Color = b.Color
		part.Material = b.Material
	end)
	hbBackup[part] = nil
end

local function hbRestoreAll()
	for part in pairs(hbBackup) do hbRestore(part) end
end

local function hbApply(part)
	if not part then return end
	if not hbBackup[part] then
		hbBackup[part] = {
			Size = part.Size, Transparency = part.Transparency, CanCollide = part.CanCollide,
			Color = part.Color, Material = part.Material,
		}
	end
	local s = Vector3.new(cfg.hbSize, cfg.hbSize, cfg.hbSize)
	if part.Size ~= s then part.Size = s end
	part.Transparency = 0.6
	part.Color = PINK
	part.Material = Enum.Material.Neon
	part.CanCollide = false
end

bind(RunService.Heartbeat, function()
	if not cfg.hitbox then
		if next(hbBackup) then hbRestoreAll() end
		return
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if isEnemy(p) then
			local char, _, root, head = getChar(p)
			if char then
				if cfg.hbPart == "Head" or cfg.hbPart == "Both" then hbApply(head) else hbRestore(head) end
				if cfg.hbPart == "Root" or cfg.hbPart == "Both" then hbApply(root) else hbRestore(root) end
			end
		end
	end
	for part in pairs(hbBackup) do
		if not part.Parent then hbBackup[part] = nil end
	end
end)

--// gun mods (best effort, client side values)
local gunBackup = {}
local gunTargets = { RecoilControl = 0, MaxSpread = 0, Spread = 0, Auto = true }
local function applyGunMods(on)
	pcall(function()
		local weapons = ReplicatedStorage:FindFirstChild("Weapons")
		if not weapons then return end
		for _, w in ipairs(weapons:GetChildren()) do
			for name, newVal in pairs(gunTargets) do
				local v = w:FindFirstChild(name)
				if v and v:IsA("ValueBase") then
					pcall(function()
						if on then
							if gunBackup[v] == nil then gunBackup[v] = v.Value end
							v.Value = newVal
						elseif gunBackup[v] ~= nil then
							v.Value = gunBackup[v]
							gunBackup[v] = nil
						end
					end)
				end
			end
		end
	end)
end

--// movement
bind(RunService.Heartbeat, function(dt)
	local char, hum, root = getChar(lp)
	if not char then return end
	local cam = Workspace.CurrentCamera
	if cfg.fly and cam then
		local cf = cam.CFrame
		local dir = Vector3.zero
		if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + cf.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - cf.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + cf.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - cf.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.yAxis end
		if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.yAxis end
		root.AssemblyLinearVelocity = dir.Magnitude > 0 and dir.Unit * cfg.flySpeed or Vector3.zero
	elseif cfg.speed then
		local md = hum.MoveDirection
		if md.Magnitude > 0 then
			root.CFrame = root.CFrame + md * cfg.speedVal * dt
		end
	end
end)

bind(RunService.Stepped, function()
	if not cfg.noclip then return end
	local char = lp.Character
	if not char then return end
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") and d.CanCollide then d.CanCollide = false end
	end
end)

bind(UIS.JumpRequest, function()
	if not cfg.infJump then return end
	local _, _, root = getChar(lp)
	if root then
		local v = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(v.X, cfg.jumpPower, v.Z)
	end
end)

