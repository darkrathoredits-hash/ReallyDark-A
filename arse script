local function addSlider(page, text, key, min, max, suffix, onChange)
	local row = mkRow(page, 54)
	mkText(row, text, 13, UDim2.new(1, -100, 0, 20), UDim2.new(0, 12, 0, 6))
	local val = mkText(row, "", 13, UDim2.new(0, 80, 0, 20), UDim2.new(1, -92, 0, 6), Enum.TextXAlignment.Right, SOFT)
	local track = mk("Frame", {
		Position = UDim2.new(0, 12, 0, 36), Size = UDim2.new(1, -24, 0, 6),
		BackgroundColor3 = OFF, BorderSizePixel = 0, ZIndex = 6,
	}, row)
	corner(track, 3)
	local fill = mk("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = PINK, BorderSizePixel = 0, ZIndex = 7 }, track)
	corner(fill, 3)
	local knob = mk("Frame", {
		Size = UDim2.fromOffset(14, 14), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 8,
	}, track)
	corner(knob, 7)
	local function visual(v)
		local a = (v - min) / (max - min)
		fill.Size = UDim2.new(a, 0, 1, 0)
		knob.Position = UDim2.new(a, -7, 0.5, -7)
		val.Text = tostring(v) .. (suffix or "")
	end
	local function fromX(x)
		local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		local v = math.clamp(math.floor(min + (max - min) * a + 0.5), min, max)
		cfg[key] = v
		visual(v)
		if onChange then onChange(v) end
	end
	visual(cfg[key])
	local sliding = false
	row.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			sliding = true
			fromX(i.Position.X)
		end
	end)
	bind(UIS.InputChanged, function(i)
		if sliding and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			fromX(i.Position.X)
		end
	end)
	bind(UIS.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			sliding = false
		end
	end)
end

