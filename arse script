local function new(class: string, props: {[string]: any}, parent: Instance?)
	local obj = Instance.new(class)
	for k, v in pairs(props) do
		obj[k] = v
	end
	obj.Parent = parent
	return obj
end

local function isEnemy(p: Player): boolean
	if not S.TeamCheck then return true end
	if p.Team and LocalPlayer.Team and p.Team == LocalPlayer.Team then
		return false
	end
	return true
end

local function getHumanoid(char: Model?): Humanoid?
	return char and char:FindFirstChildOfClass("Humanoid") or nil
end

local function isVisible(part: BasePart, char: Model): boolean
	local ignore = { char }
	if LocalPlayer.Character then
		table.insert(ignore, LocalPlayer.Character)
	end
	local blocking = Camera:GetPartsObscuringTarget({ part.Position }, ignore)
	for _, hit in ipairs(blocking) do
		if hit.CanCollide and hit.Transparency < 0.9 then
			return false
		end
	end
	return true
end

