local function destroyEsp(p)
	local o = espObjs[p]
	if not o then return end
	pcall(function() o.hl:Destroy() end)
	pcall(function() o.bb:Destroy() end)
	if o.box then pcall(function() o.box:Remove() end) end
	if o.line then pcall(function() o.line:Remove() end) end
	if o.tf then pcall(function() o.tf:Destroy() end) end
	espObjs[p] = nil
end

local function hideEsp(o)
	o.hl.Enabled = false
	o.bb.Enabled = false
	if o.tf then o.tf.Visible = false end
	if o.box then o.box.Visible = false end
	if o.line then o.line.Visible = false end
end

local function stepEsp(cam)
	for p, o in pairs(espObjs) do
		local char, hum, root, head = getChar(p)
		if not (cfg.esp and char and isEnemy(p)) then
			hideEsp(o)
		else
			if o.hl.Adornee ~= char then o.hl.Adornee = char end
			o.hl.Enabled = cfg.chams

			if o.bb.Adornee ~= head then o.bb.Adornee = head end
			o.bb.Enabled = cfg.names or cfg.distance or cfg.health
			local parts = {}
			if cfg.names then parts[#parts + 1] = p.DisplayName end
			if cfg.distance then
				parts[#parts + 1] = string.format("[%dm]", math.floor((cam.CFrame.Position - root.Position).Magnitude))
			end
			o.lbl.Text = table.concat(parts, " ")
			o.bar.Visible = cfg.health
			local ratio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
			o.fill.Size = UDim2.new(ratio, 0, 1, 0)
			o.fill.BackgroundColor3 = DEEP:Lerp(SOFT, ratio)

			if o.tf then
				local rp2, on2 = cam:WorldToViewportPoint(root.Position)
				if on2 and cfg.tracers then
					local lg2 = cam:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
					local vs2 = cam.ViewportSize
					local from = Vector2.new(vs2.X / 2, vs2.Y)
					local to = Vector2.new(rp2.X, lg2.Y)
					local d = to - from
					o.tf.Size = UDim2.fromOffset(d.Magnitude, 1.5)
					o.tf.Position = UDim2.fromOffset((from.X + to.X) / 2, (from.Y + to.Y) / 2)
					o.tf.Rotation = math.deg(math.atan2(d.Y, d.X))
					o.tf.Visible = true
				else
					o.tf.Visible = false
				end
			end
			if o.box or o.line then
				local rp, on = cam:WorldToViewportPoint(root.Position)
				if on then
					local hp = cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.6, 0))
					local lg = cam:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
					local h = math.abs(hp.Y - lg.Y)
					local w = h * 0.6
					if o.box then
						o.box.Size = Vector2.new(w, h)
						o.box.Position = Vector2.new(rp.X - w / 2, hp.Y)
						o.box.Visible = cfg.boxes
					end
					if o.line then
						local vs = cam.ViewportSize
						o.line.From = Vector2.new(vs.X / 2, vs.Y)
						o.line.To = Vector2.new(rp.X, lg.Y)
						o.line.Visible = cfg.tracers
					end
				else
					if o.box then o.box.Visible = false end
					if o.line then o.line.Visible = false end
				end
			end
		end
	end
end

