local fovCircle
if Drawing and Drawing.new then
	local ok, c = pcall(Drawing.new, "Circle")
	if ok and c then
		fovCircle = c
		c.Thickness = 1
		c.NumSides = 64
		c.Filled = false
		c.Color = Color3.fromRGB(255, 255, 255)
		c.Transparency = 1
		c.Visible = false
	end
end

local function getTarget(): BasePart?
	local best: BasePart? = nil
	local bestDist = S.FOV
	local mousePos = UIS:GetMouseLocation()
	local partName = S.TargetHead and "Head" or "HumanoidRootPart"

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and isEnemy(p) then
			local char = p.Character
			local hum = getHumanoid(char)
			local part = char and char:FindFirstChild(partName)
			if char and hum and part and hum.Health > 0 then
				local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
				if onScreen then
					local d = (Vector2.new(sp.X, sp.Y) - mousePos).Magnitude
					if d < bestDist and (not S.WallCheck or isVisible(part, char)) then
						best = part
						bestDist = d
					end
				end
			end
		end
	end
	return best
end

local hookInstalled = false
if hookmetamethod and getnamecallmethod then
	local oldNamecall
	local ok = pcall(function()
		oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
			if alive and S.SilentAim and currentTarget and self == Workspace and not (checkcaller and checkcaller()) then
				local method = getnamecallmethod()
				if method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRay" or method == "FindPartOnRayWithWhitelist" then
					local args = table.pack(...)
					local ray = args[1]
					if typeof(ray) == "Ray" and currentTarget.Parent then
						args[1] = Ray.new(ray.Origin, (currentTarget.Position - ray.Origin).Unit * ray.Direction.Magnitude)
						return oldNamecall(self, table.unpack(args, 1, args.n))
					end
				elseif method == "Raycast" then
					local args = table.pack(...)
					if typeof(args[1]) == "Vector3" and typeof(args[2]) == "Vector3" and currentTarget.Parent then
						args[2] = (currentTarget.Position - args[1]).Unit * args[2].Magnitude
						return oldNamecall(self, table.unpack(args, 1, args.n))
					end
				end
			end
			return oldNamecall(self, ...)
		end)
	end)
	hookInstalled = ok
end

----------------------------------------------------------------------
-- hitbox expander
----------------------------------------------------------------------

local origParts = setmetatable({}, { __mode = "k" })

local function restoreHitboxes()
	for part, data in pairs(origParts) do
		if part and part.Parent then
			part.Size = data.Size
			part.Transparency = data.Transparency
			part.CanCollide = data.CanCollide
		end
	end
	table.clear(origParts)
end

local function expandPart(part: BasePart)
	if not origParts[part] then
		origParts[part] = { Size = part.Size, Transparency = part.Transparency, CanCollide = part.CanCollide }
	end
	local s = S.HitboxSize
	part.Size = Vector3.new(s, s, s)
	part.Transparency = 0.8
	part.CanCollide = false
end

local function updateHitboxes()
	if not S.Hitbox then
		if next(origParts) then restoreHitboxes() end
		return
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and isEnemy(p) then
			local char = p.Character
			local hum = getHumanoid(char)
			if char and hum and hum.Health > 0 then
				local hrp = char:FindFirstChild("HumanoidRootPart")
				if hrp then expandPart(hrp) end
				if S.HitboxHead then
					local head = char:FindFirstChild("Head")
					if head then expandPart(head) end
				end
			end
		end
	end
end

