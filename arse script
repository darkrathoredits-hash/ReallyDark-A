----------------------------------------------------------------------
-- esp
----------------------------------------------------------------------

local espObjs = {}

local function removeESP(p: Player)
	local o = espObjs[p]
	if o then
		o.hl:Destroy()
		o.bb:Destroy()
		espObjs[p] = nil
	end
end

local function updateESP()
	for p in pairs(espObjs) do
		if not p.Parent or not S.ESP then
			removeESP(p)
		end
	end
	if not S.ESP then return end

	local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			local char = p.Character
			local hum = getHumanoid(char)
			local head = char and char:FindFirstChild("Head")
			if char and hum and head and hum.Health > 0 and isEnemy(p) then
				local o = espObjs[p]
				if o and o.char ~= char then
					removeESP(p)
					o = nil
				end
				if not o then
					local hl = new("Highlight", {
						Adornee = char,
						FillColor = Color3.fromRGB(220, 60, 60),
						OutlineColor = Color3.fromRGB(255, 255, 255),
						FillTransparency = 0.6,
						OutlineTransparency = 0,
						DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
					}, espFolder)
					local bb = new("BillboardGui", {
						Adornee = head,
						Size = UDim2.new(0, 180, 0, 32),
						StudsOffset = Vector3.new(0, 2.5, 0),
						AlwaysOnTop = true,
					}, espFolder)
					local lbl = new("TextLabel", {
						Size = UDim2.fromScale(1, 1),
						BackgroundTransparency = 1,
						TextColor3 = Color3.new(1, 1, 1),
						TextStrokeTransparency = 0.4,
						Font = Enum.Font.GothamBold,
						TextSize = 13,
						Text = "",
					}, bb)
					o = { hl = hl, bb = bb, label = lbl, char = char }
					espObjs[p] = o
				end
				o.bb.Enabled = S.ESPNames
				if S.ESPNames then
					local dist = myRoot and math.floor((myRoot.Position - head.Position).Magnitude) or 0
					o.label.Text = string.format("%s  [%d hp]  %dm", p.DisplayName, math.floor(hum.Health), dist)
				end
			else
				removeESP(p)
			end
		end
	end
end

